#!/bin/bash

VERSION=$(git describe --tags)

ALL_PLATFORMS=(
    "linux/amd64"
    "linux/arm64"
    "linux/arm"
    "linux/386"
    "windows/386"
    "windows/amd64"
    "windows/arm64"
    "darwin/amd64"
    "darwin/arm64"
)

ASSETS_DEFAULT_EXCLUDES=(
    "example*"
    #TODO: return when it's fixed
    "index-modern.html*"
)

# Override target dist folder but do not remove existed releases
# This value may be changed via -c cli arg
CLEANUP_DIST="false"

DIST_DIR="./dist/$VERSION"

build_assets() {
    local dst_assets_file="$1"
    local dst_assets_full_file="$2"
    local src_dir="$(cd "$(dirname web/assets)" && pwd)/assets"

    archive() {
        local dst_file="$1"
        local full="$2"

        local abs_dst="$(cd "$(dirname "$dst_file")" && pwd)/$(basename "$dst_file")"

        if [ ! -e "$abs_dst" ]; then
            local flags=()
            if [ "$full" != "true" ]; then
                for e in "${ASSETS_DEFAULT_EXCLUDES[@]}"; do
                    flags+=("--exclude=$e")
                done
            fi

            (cd "$src_dir" && if [ "${dst_file##*.}" = "zip" ]; then
                zip -rq ${flags[@]} "$abs_dst" .
            else
                tar ${flags[@]} -czf "$abs_dst" .
            fi)
        fi
    }

    archive "$dst_assets_file" "false"
    archive "$dst_assets_full_file" "true"
}

build_bin() {
    local target_os="$1"
    local target_arch="$2"
    local out_dir="$3"

    mkdir -p "$out_dir"

    case "$BUILDER_TYPE" in
    local)
        go mod download
        CGO_ENABLED=0 GOOS="$target_os" GOARCH="$target_arch" \
            go build -ldflags "-w -s" -trimpath -buildvcs=false -o "$out_dir/$([ "$target_os" = "windows" ] && echo speedtest-go.exe || echo speedtest-go)" .
        ;;
    docker)
        docker buildx build \
            --output "type=local,dest=$out_dir" \
            --target "bin_builder" \
            --build-arg TARGETOS="$target_os" \
            --build-arg TARGETARCH="$target_arch" \
            -f Dockerfile.build .
        ;;
    *)
        printf "Error: unknown builder type '%s' (expected: local, docker, auto)\n" "$BUILDER_TYPE" >&2
        exit 1
        ;;
    esac
}

build_final_package() {
    local dst_file="$1"
    local tmp_bin_dir="$2"
    local tmp_assets_full_file="$3"
    local tmp_assets_file="$4"

    mkdir -p "$DIST_DIR"

    local abs_dst_file="$(cd "$(dirname "$dst_file")" && pwd)/$(basename "$dst_file")"

    # Create staging directory containing the binary and both asset archives
    local stage_dir="$(mktemp -d)"

    cp -r "$tmp_bin_dir"/* "$stage_dir"
    cp "$tmp_assets_full_file" "$stage_dir"
    cp "$tmp_assets_file" "$stage_dir"
    cp "$tmp_assets_file" "$stage_dir"
    cp "server-list.json" "$stage_dir/server-list.example.json"
    cp "settings.toml" "$stage_dir/settings.example.toml"
    cp "README.md" "$stage_dir"
    cp "LICENSE" "$stage_dir"

    rm -f "$abs_dst_file"

    if [ "${tmp_bin_dir##*/}" = "zip" ]; then
        (cd "$stage_dir" && zip -rq "$abs_dst_file" .)
    else
        (cd "$stage_dir" && tar -czf "$abs_dst_file" .)
    fi

    rm -rf "$stage_dir"
}

build_package() {
    local target_platform="$1"
    local target_os="${target_platform%%/*}"
    local target_arch="${target_platform##*/}"
    #TODO: extract to function
    local use_zip="false"
    local archive_ext=".tar.gz"

    case "$target_os" in
    windows | darwin)
        use_zip="true"
        archive_ext=".zip"
        ;;
    esac

    printf "Building '$target_platform' package...\n"

    # Build bin app files
    local tmp_bin_dir="./build/bin/$target_platform"
    build_bin "$target_os" "$target_arch" "$tmp_bin_dir"

    # Build assets
    local tmp_assets_file="./build/assets${archive_ext}"
    local tmp_assets_full_file="./build/assets_full${archive_ext}"

    build_assets "$tmp_assets_file" "$tmp_assets_full_file"

    #Build final distribution archine
    local package_name="speedtest-go-${target_os}_${target_arch}_$VERSION$archive_ext"
    local dist_file="$DIST_DIR/$package_name"

    build_final_package "$dist_file" "$tmp_bin_dir" "$tmp_assets_full_file" "$tmp_assets_file"

    printf "A '$target_os/$target_arch' package was saved to '$dist_file' file \n"
}

build_deb() {
    local target_arch="$1"
    local out_dir="$DIST_DIR"

    mkdir -p "$out_dir"

    case "$BUILDER_TYPE" in
    local)
        go mod download
        DEB_HOST_ARCH="$target_arch" \
            DEST_DIR="$out_dir" \
            VERSION="$VERSION" \
            ./deb/build.sh
        ;;
    docker)
        docker buildx build \
            --output "type=local,dest=$out_dir" \
            --target "deb_builder" \
            --build-arg TARGETOS="$target_os" \
            --build-arg TARGETARCH="$target_arch" \
            --build-arg VERSION="$VERSION" \
            -f Dockerfile.build .
        ;;
    *)
        printf "Error: unknown builder type '%s' (expected: local, docker, auto)\n" "$BUILDER_TYPE" >&2
        exit 1
        ;;
    esac
}

build_package_deb() {
    local target_platform="$1"
    local target_os="${target_platform%%/*}"
    local target_arch="${target_platform##*/}"

    if [ "${target_os}" != "linux" ]; then
        # skip non linux targets
        return 0
    fi

    printf "Building '$target_platform' deb package...\n"

    build_deb "$target_arch"

    printf "A '$target_os/$target_arch' deb package was saved to '$DIST_DIR' dir \n"
}

generate_checksums() {
    local checksum_file="$DIST_DIR/CHECKSUM"

    cd "$DIST_DIR"

    if [ -f CHECKSUM ]; then
        rm -f CHECKSUM
    fi

    find . -type f -not -name 'CHECKSUM' -printf '%P\n' | sort | while read -r filename; do
        if [ -f "$filename" ]; then
            printf '%s  %s\n' "$(sha256sum "$filename" | cut -d ' ' -f 1)" "$filename" >>"CHECKSUM"
        fi
    done

    printf "Checksums written to '%s'\n" "$checksum_file"
}

cleanup() {
    printf "Preparing build directory...\n"
    rm -rf ./build/
    if [ "$CLEANUP_DIST" = "true" ]; then
        printf "Removing ./dist directory...\n"
        rm -rf ./dist
    fi
}

print_version() {
    printf "Package version: '$VERSION'\n"
}

print_help() {
    cat <<'EOF'
Usage: build_pkgs [command] [OPTIONS]

Commands:
  build     Build packages for all platforms. Will be used if no command specified
  help      Print this help message and exit
  version   Print the current package version and exit

Options:
  -c, --clean     Remove the ./dist directory before cleanup
  -p, --platforms Build only the given platforms (e.g. linux/amd64,linux/arm64)
  -t, --type      Builder type: local, docker or auto (default: auto)
  -v, --version   Print the current package version and exit
  -h, --help      Print this help message and exit

EOF
}

case "$1" in
build)
    shift
    ;;
-v | --version | version)
    print_version
    exit 0
    ;;
-h | --help | help)
    print_help
    exit 0
    ;;
-c | --clean)
    CLEANUP_DIST="true"
    ;;
-p | --platforms)
    value="$2"
    if [ -z "$value" ]; then
        printf "Error: --platforms requires a value\n" >&2
        printf "Usage: build_pkgs [--platforms linux/amd64,linux/arm64]\n" >&2
        exit 1
    fi
    TARGET_PLATFORMS=($(printf '%s\n' "$value" | tr ',' ' '))
    ;;
-p=* | --platforms=*)
    value="${1#*=}"
    if [ -z "$value" ]; then
        printf "Error: --platforms requires a value\n" >&2
        printf "Usage: build_pkgs [--platforms linux/amd64,linux/arm64]\n" >&2
        exit 1
    fi
    TARGET_PLATFORMS=($(printf '%s\n' "$value" | tr ',' ' '))
    ;;
-t | --type)
    value="$2"
    if [ -z "$value" ]; then
        printf "Error: --type requires a value\n" >&2
        printf "Usage: build_pkgs [--type local|docker|auto]\n" >&2
        exit 1
    fi
    BUILDER_TYPE="$value"
    ;;
-t=* | --type=*)
    value="${1#*=}"
    if [ -z "$value" ]; then
        printf "Error: --type requires a value\n" >&2
        printf "Usage: build_pkgs [--type local|docker|auto]\n" >&2
        exit 1
    fi
    BUILDER_TYPE="$value"
    ;;
esac

# Validate requested platforms against the known set
if [ -n "${TARGET_PLATFORMS+x}" ]; then
    for platform in "${TARGET_PLATFORMS[@]}"; do
        if [[ " ${ALL_PLATFORMS[*]} " != *" $platform "* ]]; then
            printf "Error: unknown platform '%s'\n" "$platform" >&2
            printf "Valid platforms:\n" >&2
            printf "  %s\n" "${ALL_PLATFORMS[@]}" >&2
            exit 1
        fi
    done
fi

# Resolve the builder type: explicit value or auto-detection
if [ -z "${BUILDER_TYPE:-}" ]; then
    BUILDER_TYPE="auto"
fi

if [[ "$BUILDER_TYPE" != "local" && "$BUILDER_TYPE" != "docker" && "$BUILDER_TYPE" != "auto" ]]; then
    printf "Error: unknown builder type '%s' (expected: local, docker, auto)\n" "$BUILDER_TYPE" >&2
    printf "Usage: build_pkgs [--type local|docker|auto]\n" >&2
    exit 1
fi

if [ "$BUILDER_TYPE" = "auto" ]; then
    #Prefer local installation
    if command -v go >/dev/null 2>&1; then
        BUILDER_TYPE="local"
        printf "Auto-detected builder: local\n"

    elif docker buildx version >/dev/null 2>&1; then
        BUILDER_TYPE="docker"
        printf "Auto-detected builder: docker\n"

    else
        printf "Error: no builder available (need 'docker' or 'go' installed)\n" >&2
        exit 1
    fi
fi

# Build only the requested platforms, or all by default
PLATFORMS=("${TARGET_PLATFORMS[@]+"${TARGET_PLATFORMS[@]}"}")
[ ${#PLATFORMS[@]} -eq 0 ] && PLATFORMS=("${ALL_PLATFORMS[@]}")

cleanup

trap 'printf "Interrupted by user, stopping build cycle.\n"; exit 130' INT TERM
for platform in "${PLATFORMS[@]}"; do
    build_package "$platform"
done

for platform in "${PLATFORMS[@]}"; do
    build_package_deb "$platform"
done

generate_checksums
