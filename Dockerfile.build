FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build_base

RUN apk add --no-cache git gcc ca-certificates libc-dev
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY ./ ./

ENV CGO_ENABLED=0

ARG TARGETOS
ARG TARGETARCH
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-w -s" -trimpath -buildvcs=false .

RUN ls


FROM scratch AS bin_builder
# A special target to copy result binary only
# It's used only for preparing distribuiton packages
#and is **not** used for preparing result dcoker images
WORKDIR /
COPY --from=build_base /build/speedtest* ./
